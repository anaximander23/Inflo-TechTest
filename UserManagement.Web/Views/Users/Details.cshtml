@model UserManagement.Web.Models.Users.UserViewModel

<div>
    <h2>User Details</h2>
    <div>
        <dl class="row">
            <dt class="col-sm-2">Forename</dt>
            <dd class="col-sm-10">@Model.Forename</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Surname</dt>
            <dd class="col-sm-10">@Model.Surname</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Email</dt>
            <dd class="col-sm-10">@Model.Email</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Date of birth</dt>
            <dd class="col-sm-10">@Model.DateOfBirth</dd>
        </dl>

        <dl class="row">
            <dt class="col-sm-2">Account Active</dt>
            <dd class="col-sm-10">@(Model.IsActive ? "Yes" : "No")</dd>
        </dl>
    </div>
    <div>
        <a asp-controller="Users" asp-action="List" class="btn btn-default">Back to list</a>
@if (User.IsInRole("Admin"))
{
        <a asp-controller="Users" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
}
    </div>
</div>

@if (User.IsInRole("Admin"))
{
<hr />
<h3>Activity logs</h3>

<partial name="_LogPager" model="Model.ActivityLogs" />

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Time</th>
                <th>Action</th>
                <th>Description</th>
                <th>Actor</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ActivityLogs.Items.Count == 0)
            {
                <tr>
                    <td colspan="4" class="text-muted">No actions recorded for this user.</td>
                </tr>
            }
            else
            {
                @foreach (var log in Model.ActivityLogs.Items)
                {
                    <tr>
                        <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@log.Action</td>
                        <td>@log.Description</td>
                        <td>@(log.ActorEmail ?? "(unknown)")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<partial name="_LogPager" model="Model.ActivityLogs" />
}
